{
  "name": "openword",
  "productName": "OpenWord",
  "version": "0.1.0",
  "private": true,
  "description": "Procesador de textos de escritorio compatible con Word",
  "author": "OpenWord",
  "homepage": "https://github.com/openword/openword",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json && tsc -p tsconfig.e2e.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "check:deps": "node scripts/check-forbidden-deps.mjs",
    "package": "npm run build && electron-builder",
    "package:dir": "npm run build && electron-builder --dir"
  },
  "devDependencies": {
    "@docx-editor.dev/core": "2.27.0",
    "@docx-editor.dev/fonts": "2.27.0",
    "@docx-editor.dev/i18n": "2.27.0",
    "@docx-editor.dev/react": "2.27.0",
    "@electron/fuses": "2.1.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "cfb": "1.2.2",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fflate": "0.8.3",
    "globals": "17.13.0",
    "i18next": "26.4.3",
    "prettier": "3.9.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.16",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "7.3.7",
    "vitest": "5.0.3",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  }
}
