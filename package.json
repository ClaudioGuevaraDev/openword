{
  "name": "openword",
  "productName": "OpenWord",
  "version": "0.6.2",
  "private": true,
  "description": "Procesador de textos de escritorio compatible con Word",
  "author": "OpenWord",
  "homepage": "https://github.com/openword/openword",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json && tsc -p tsconfig.e2e.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:e2e": "pnpm run build && playwright test",
    "check:deps": "node scripts/check-forbidden-deps.mjs && node scripts/check-exact-versions.mjs",
    "package": "pnpm run build && electron-builder",
    "package:dir": "pnpm run build && electron-builder --dir",
    "fidelity": "vitest run --project fidelity",
    "fidelity:report": "pnpm run build && playwright test --config playwright.fidelity.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@docx-editor.dev/core": "2.27.0",
    "@docx-editor.dev/fonts": "2.27.0",
    "@docx-editor.dev/i18n": "2.27.0",
    "@docx-editor.dev/react": "2.27.0",
    "@electron/fuses": "2.1.3",
    "@eslint/js": "10.0.1",
    "@fluentui/react-icons": "2.0.344",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "5.0.3",
    "cfb": "1.2.2",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.12.0",
    "eslint-plugin-playwright": "2.12.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-xml-parser": "5.11.2",
    "fflate": "0.8.3",
    "globals": "17.13.0",
    "i18next": "26.4.3",
    "pdfjs-dist": "6.4.299",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.16",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "7.3.7",
    "vitest": "5.0.3",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "5.3.0"
  }
}
